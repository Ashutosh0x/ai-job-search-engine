# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Ingestion artifacts (regenerate with scripts/ingest-v2.mjs)
/public/data/*.json
# ...except the bounded deployment index, which MUST be committed.
#
# This Vercel project auto-deploys from GitHub. A git-triggered build sees only
# what is in the repository, so with this file ignored every `git push`
# produced a deployment whose search API answered
# "Job index is not available" -- while `vercel deploy` from a laptop worked,
# because the CLI uploads local files. The deploy that worked and the deploy
# that shipped were built from different file sets.
#
# Committing it makes a deployment reproducible from the repository alone.
#
# It outgrew GitHub's 100 MiB hard limit once curated employers began being
# served complete (84MB and rising), so it is now written as shards. The second
# negation is not optional: without it the shards are ignored, the primary file
# deploys alone, and the site serves the first 60MB of the index while looking
# perfectly healthy.
!/public/data/jobs-deploy.json
!/public/data/jobs-deploy.*.json
/.ingest-state.json
/public/data/ibm-jobs.json

.vercel

# Crawl logs are working files, not deliverables.
*.log

# Common Crawl index pages, cached so a re-harvest does not refetch ~450MB.
/.cc/
# Role-hunt outputs: generated by scripts/hunt-role.mjs and crawl-board.mjs,
# reproducible from the scripts, and stale the moment a board changes.
/jobs.txt
/hunt-results.json
/argentina-recruiters.json
/argentina-recruiters.txt
/clearstreet-roles.json
/clearstreet-roles.txt
/scratch-*.json
/scripts/.last-stats.json

# Refresh concurrency lock (pid file, never committed).
.refresh.lock
/synechron-roles.json
/synechron-roles.txt
/microsoft-roles.json
/microsoft-roles.txt
/uk-tech-roles.json
/uk-tech-roles.txt
/quantiphi-roles.json
/quantiphi-roles.txt
