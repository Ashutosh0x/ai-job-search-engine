# Optional path to a Lottie JSON for the Resume Builder CTC widget
# Example: /resume-ctc.json (place the file in the public/ directory)
NEXT_PUBLIC_CTC_LOTTIE_PATH=/resume-ctc.json
# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Google AI Configuration
GOOGLE_AI_API_KEY=your_google_ai_key
GEMINI_API_KEY=your_gemini_api_key
# Optional model override for AI interview planning, adaptive turns, and
# practice assessments. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Email Configuration (Resend)
RESEND_API_KEY=your_resend_api_key

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Product IDs (create these in your Stripe dashboard)
STRIPE_BASIC_PRICE_ID=price_basic_plan_id
STRIPE_PRO_PRICE_ID=price_pro_plan_id
STRIPE_PREMIUM_PRICE_ID=price_premium_plan_id

# ---------------------------------------------------------------------------
# Analytics (see docs/ANALYTICS.md)
# ---------------------------------------------------------------------------
# Where events are stored: supabase | memory | none
# Default: supabase when the Supabase vars above are set, otherwise memory.
ANALYTICS_DRIVER=memory
# Set to 1 to turn the whole analytics system off.
ANALYTICS_DISABLED=0
# Salt for the daily-rotating session hash. SET THIS IN PRODUCTION: without it
# each server instance salts differently, so one visitor is counted once per
# instance and unique figures are inflated.
ANALYTICS_SALT=change_me_to_32_plus_random_bytes
# How long raw events are kept. Enforced by scripts/prune-analytics.mjs, which
# must be scheduled -- it does not run on its own.
ANALYTICS_RETENTION_DAYS=90

# Who may open /admin/analytics. Comma-separated, matched against the VERIFIED
# email on the Supabase session. UNSET MEANS NOBODY -- this fails closed.
ADMIN_EMAILS=
